# MarkerVault production environment template (S-11/S-01/S-12).
# Install: sudo install -d -m 750 -o root -g markervault /etc/markervault
#          sudo cp markervault.env.example /etc/markervault/markervault.env
#          sudo chown root:markervault /etc/markervault/markervault.env
#          sudo chmod 640 /etc/markervault/markervault.env
# Then fill in the secret below. This file is read by systemd (EnvironmentFile),
# install.sh, seed.sh, and any CLI invocation that must target the production database.
# The real /etc/markervault/markervault.env is never committed to the repository.

MARKERVAULT_ENVIRONMENT=production

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Production startup refuses to run while this is empty or shorter than 32 characters.
# Rotating it invalidates all access tokens and signed media URLs.
MARKERVAULT_ACCESS_TOKEN_SECRET=

# Runtime state lives outside the nginx public root (S-01). Production startup
# refuses relative paths. db/ is owner-only; media dirs are group-readable so nginx
# can serve them through the internal aliases. If you change a media path here, the
# matching internal_* alias in markervault.nginx must change with it.
MARKERVAULT_DB_PATH=/var/lib/markervault/db/spots.db
MARKERVAULT_PHOTOS_PATH=/var/lib/markervault/photos
MARKERVAULT_THUMBS_PATH=/var/lib/markervault/thumbs
MARKERVAULT_AVATARS_PATH=/var/lib/markervault/avatars
MARKERVAULT_TEMP_PATH=/var/lib/markervault/temp

# Host allowlist (S-12): must mirror the server_name lists in markervault.nginx.
# CANONICAL holds the future public hostname; markervault.lan stands in until launch.
# TEMPORARY_LAN holds LAN hostnames/IPs allowed pre-launch (comma-separated) and is
# removed at public launch. Never use wildcards.
MARKERVAULT_CANONICAL_HOSTS=markervault.lan
MARKERVAULT_TEMPORARY_LAN_HOSTS=markervault.lan

# Account lifecycle mode. The default keeps verification, password recovery, and
# SMTP disabled: administrators create/approve accounts and reset passwords. To
# enable email-assisted accounts, configure every SMTP value below, set the public
# origin to an allowlisted HTTPS origin, then set both booleans true in one reviewed
# cutover. Never derive emailed links from request Host headers.
MARKERVAULT_EMAIL_DELIVERY_ENABLED=false
MARKERVAULT_REQUIRE_EMAIL_VERIFICATION=false
#MARKERVAULT_PUBLIC_ORIGIN=https://markervault.lan
#MARKERVAULT_SMTP_HOST=smtp.example.com
#MARKERVAULT_SMTP_PORT=587
#MARKERVAULT_SMTP_TIMEOUT=10
#MARKERVAULT_SMTP_SECURITY=starttls
#MARKERVAULT_SMTP_FROM_ADDRESS=markervault@example.com
#MARKERVAULT_SMTP_ENVELOPE_FROM=markervault@example.com
#MARKERVAULT_SMTP_USERNAME=markervault@example.com
#MARKERVAULT_SMTP_PASSWORD=

# Token defaults: email verification 24 hours, password reset 30 minutes, and
# resend cooldown 60 seconds. Override only with an owner-reviewed reason.
#MARKERVAULT_EMAIL_VERIFICATION_TOKEN_DURATION=86400
#MARKERVAULT_PASSWORD_RESET_TOKEN_DURATION=1800
#MARKERVAULT_EMAIL_RESEND_COOLDOWN=60

# Aggregate remote-photo download budget per KML import job, in original
# (pre-re-encode) bytes (S-09). Markers past the budget still import; their
# photos are skipped and reported as "download limit reached". Default 2 GiB.
#MARKERVAULT_KML_MAX_DOWNLOAD_BYTES=2147483648

# Remote-photo attempt and elapsed-time budgets per KML import. Failures consume an
# attempt. When either budget is exhausted, remaining photos are budget-skipped while
# the remaining marker rows still import. Defaults: 500 attempts and 900 seconds.
#MARKERVAULT_KML_MAX_FETCH_ATTEMPTS=500
#MARKERVAULT_KML_MAX_JOB_SECONDS=900

# Maximum retained notification-history rows per user. Oldest rows are trimmed on
# insert; no background retention job is used. Default 200.
#MARKERVAULT_NOTIF_HISTORY_CAP=200
